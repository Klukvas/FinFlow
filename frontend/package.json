{
  "name": "accounting-app-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:seo": "vite build && node scripts/prerender.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:auth": "playwright test tests/auth.spec.ts",
    "test:category": "playwright test tests/category.test.ts",
    "test:expense": "playwright test tests/expense.test.ts",
    "test:mobile": "playwright test --project=Mobile Chrome --project=Mobile Safari",
    "generate:types": "cd .. && bash scripts/collect-openapi-schemas.sh && bash scripts/generate-api-types.sh",
    "check:contract-drift": "node scripts/check-contract-drift.mjs",
    "test:types": "node scripts/check-type-compat.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "dompurify": "^3.3.1",
    "gray-matter": "^4.0.3",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.3",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.48.0",
    "@types/dompurify": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "openapi-typescript": "^7.13.0",
    "puppeteer": "^24.37.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vite-tsconfig-paths": "^5.1.4",
    "workbox-build": "^7.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22"
}
